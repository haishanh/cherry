{
  "name": "cherry",
  "version": "0.0.10",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.3.4",
  "license": "UNLICENSED",
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-svelte"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "vite dev",
    "test": "LOG_LEVEL=error vitest",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-package",
    "sync": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "bundle:cli": "esbuild src/cli/index.ts --bundle --minify --platform=node --format=cjs --target=node24 --outfile=cherry.cjs --external:@node-rs/argon2 --external:@node-rs/* --external:better-sqlite3",
    "fetch:signal-tokenizer": "node scripts/fetch-signal-tokenizer.mjs",
    "cherry": "tsx src/cli/index.ts",
    "lint": "prettier --check src scripts && eslint --cache src",
    "lint:fix": "eslint --cache --fix src",
    "prettier:fix": "prettier --write src scripts",
    "fix": "pnpm lint:fix && pnpm prettier:fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@lucide/svelte": "1.42.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/debug": "4.1.13",
    "@types/estree": "1.0.9",
    "autoprefixer": "10.5.5",
    "date-fns": "4.4.0",
    "domhandler": "6.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-svelte": "^3.23.0",
    "file-selector": "5.0.1",
    "globals": "17.12.0",
    "ky": "2.1.0",
    "nanoid": "6.0.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "sade": "1.8.1",
    "sass": "1.104.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-file-dropzone": "2.0.9",
    "tiny-invariant": "1.3.3",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "uint8array-extras": "1.5.0",
    "undici": "8.10.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/lib-storage": "3.1127.0",
    "@node-rs/argon2": "2.2.0",
    "better-sqlite3": "13.0.3",
    "csv-stringify": "6.8.3",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "file-type": "22.0.2",
    "htmlparser2": "12.0.0",
    "tar": "7.5.22",
    "zod": "4.5.4"
  }
}
